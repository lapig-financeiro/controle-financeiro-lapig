{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "simulador-bolsas",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "NãoColocarNoGit/analise-bolsas-2027/tela"
      ],
      "port": 8765
    },
    {
      "name": "planejamento-bolsas",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8766
    },
    {
      "name": "app-v2",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "preview", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "app-v2-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev", "--", "--port", "5173", "--strictPort"],
